<%- include('partials/header') %>

<!-- Main projects container -->
<div class="container">

    <!-- Page introduction -->
    <h1 class="text-center mb-4">My Projects</h1>

    <p class="text-center mb-5">
        Here are some of the projects I have worked on
        throughout my studies and personal development.
    </p>

    <!-- Project card layout -->
    <div class="row">

        <!-- Portfolio website project -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card project-card h-100">

                <!-- Project screenshot -->
                <img src="/images/portfolio.png"
                     class="card-img-top"
                     alt="Portfolio Website">

                <!-- Project description -->
                <div class="card-body">
                    <h5 class="card-title">Portfolio Website</h5>

                    <p class="card-text">
                        A personal portfolio website created using
                        HTML, CSS, Express, and EJS.
                    </p>
                </div>

            </div>
        </div>

        <!-- Networking project -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card project-card h-100">

                <!-- Networking screenshot -->
                <img src="/images/networking.png"
                    class="card-img-top"
                    alt="Networking Lab Projects">

                <!-- Project description -->
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fa-solid fa-network-wired"></i>
                        Networking Lab Projects
                    </h5>

                    <p class="card-text">
                        Configuration and troubleshooting of network
                        devices, routing protocols, and network services.
                    </p>
                </div>

            </div>
        </div>

        <!-- JavaScript project -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card project-card h-100">

                <!-- JavaScript screenshot -->
                <img src="/images/javascript.png"
                    class="card-img-top"
                    alt="JavaScript Applications">

                <!-- Project description -->
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fa-brands fa-js"></i>
                        JavaScript Applications
                    </h5>

                    <p class="card-text">
                        Small web applications created while learning
                        JavaScript and Node.js.
                    </p>
                </div>

            </div>
        </div>

    </div>
</div>

<%- include('partials/footer') %>